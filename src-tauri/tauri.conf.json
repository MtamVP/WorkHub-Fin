{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "WorkHub-Fin",
  "version": "0.1.2",
  "identifier": "com.workhub.fin",
  "build": {
    "frontendDist": "../tauri-dist",
    "devUrl": "http://localhost:5701",
    "beforeBuildCommand": "node scripts/sync-web.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WorkHub Finance",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MtamVP/WorkHub-Fin/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE5RkI2MDJGMkU4OEFCOUIKUldTYnE0Z3VMMkQ3cWNScVZzMXJqTFNlOXBEcXJTUGMrenQ0YjhlUERMM1dVZnRaQm0zRlRncXoK"
    }
  },
  "bundle": {
    "createUpdaterArtifacts": true,
    "resources": ["WebView2Loader.dll"],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
